# Pinecone — https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX=ancient-recipes
# Serverless spec used when creating the index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match the dimension the Pinecone index was created with.
# Changing this requires recreating the index.
EMBEDDING_DIMENSION=1536

# --- Reranking (optional) ---------------------------------------------------
# The second retrieval stage. Without one, retrieval still works but drops from
# ~97% to ~88% Recall@1 — it degrades rather than failing, so run
# `npm run rerank:check` to confirm it is actually live.
#
# Whichever key is present wins; RERANK_PROVIDER forces a choice when several
# are. Jina and Cohere are preferred over Pinecone by default because Pinecone's
# hosted rerank is capped at 500 requests/month across the whole organisation.

# Jina — https://jina.ai/reranker  (new keys include 10M free tokens,
# roughly 3,300 queries at this document size). Defaults to jina-reranker-v3;
# if your key lacks access, set RERANK_MODEL=jina-reranker-v2-base-multilingual
JINA_API_KEY=

# Cohere — https://dashboard.cohere.com/api-keys  (trial key: 1,000 calls/month,
# development only; production is $0.001 per search)
COHERE_API_KEY=

# jina | cohere | pinecone | none
# RERANK_PROVIDER=jina
# Overrides the vendor's default model.
# RERANK_MODEL=
